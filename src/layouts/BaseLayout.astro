---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import site from "../data/site.json";
import {
  organizationJsonLd,
  personJsonLd,
  jsonLdScript,
  webPageJsonLd,
  webSiteJsonLd,
  type JsonLd,
} from "../lib/jsonld";
import { absoluteUrl } from "../lib/seo";
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/system.css";

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalPath?: string;
  jsonLd?: JsonLd | JsonLd[];
  noindex?: boolean;
}

const {
  title = site.title,
  description = site.claim,
  ogImage = "/media/og-default.jpg",
  canonicalPath,
  jsonLd,
  noindex = false,
} = Astro.props;

const currentPath = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = absoluteUrl(canonicalPath ?? currentPath);
const ogImageAbs = absoluteUrl(ogImage);

const extraLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const ldPayload = [
  organizationJsonLd(),
  personJsonLd(),
  webSiteJsonLd(),
  webPageJsonLd({ title, description, url: canonical }),
  ...extraLd,
];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#002135" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <script is:inline type="application/ld+json" set:html={jsonLdScript(ldPayload)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/reveal.ts";
    </script>
  </body>
</html>
