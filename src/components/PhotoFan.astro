---
/**
 * Matches the old uixandy Webflow "About Rotate Images" scrub:
 * sides sit left/right (absolute), scroll lifts y -50→0 then rotates to ±12°.
 */
export interface Props {
  images: { image: string; alt: string }[];
}

const { images } = Astro.props;
const photos = images.slice(0, 3);
---

<div class="fan" data-fan>
  {
    photos.map((p, i) => (
      <figure class={`fan__card fan__card--${i + 1}`}>
        <img src={p.image} alt={p.alt} width="800" height="1000" loading="lazy" decoding="async" />
      </figure>
    ))
  }
</div>

<script>
  const fan = document.querySelector<HTMLElement>("[data-fan]");
  if (!fan) {
    /* no fan on this page */
  } else if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
    fan.style.setProperty("--fan-y", "0px");
    fan.style.setProperty("--fan-rot", "12");
  } else {
    const cards = [
      fan.querySelector<HTMLElement>(".fan__card--1"),
      fan.querySelector<HTMLElement>(".fan__card--2"),
      fan.querySelector<HTMLElement>(".fan__card--3"),
    ];
    let currentY = -50;
    let currentRot = 0;
    let active = true;

    const clamp = (n: number, a: number, b: number) => Math.min(b, Math.max(a, n));
    const map01 = (p: number, a: number, b: number) => clamp((p - a) / (b - a), 0, 1);

    /** Scroll progress 0→1 while the fan moves through the viewport (Webflow startsEntering ~50%). */
    const progress = () => {
      const rect = fan.getBoundingClientRect();
      const vh = window.innerHeight || 1;
      const start = vh * 0.9;
      const end = vh * 0.15;
      return map01(start - rect.top, 0, start - end);
    };

    const apply = (y: number, rot: number) => {
      fan.style.setProperty("--fan-y", `${y.toFixed(2)}px`);
      fan.style.setProperty("--fan-rot", rot.toFixed(3));
      if (cards[0]) cards[0].style.transform = `translate3d(0, ${y.toFixed(2)}px, 0) rotate(${(-rot).toFixed(3)}deg)`;
      if (cards[1]) cards[1].style.transform = `translate3d(0, ${y.toFixed(2)}px, 0)`;
      if (cards[2]) cards[2].style.transform = `translate3d(0, ${y.toFixed(2)}px, 0) rotate(${rot.toFixed(3)}deg)`;
    };

    const tick = () => {
      if (active) {
        const p = progress();
        const targetY = -50 + 50 * map01(p, 0, 0.3);
        const targetRot = 12 * map01(p, 0, 0.5);
        // Webflow smoothing ~80
        currentY += (targetY - currentY) * 0.18;
        currentRot += (targetRot - currentRot) * 0.18;
        apply(currentY, currentRot);
      }
      requestAnimationFrame(tick);
    };

    const io = new IntersectionObserver(
      (entries) => {
        active = entries.some((e) => e.isIntersecting);
      },
      { rootMargin: "30% 0px" },
    );
    io.observe(fan);
    apply(currentY, currentRot);
    requestAnimationFrame(tick);
  }
</script>

<style>
  .fan {
    --fan-y: -50px;
    --fan-rot: 0;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    width: min(100%, 75rem);
    max-width: 1200px;
    height: clamp(17rem, 55vw, 45.625rem);
    margin: clamp(2.5rem, 5vw, 6.25rem) auto 0;
    overflow: visible;
  }

  .fan__card {
    margin: 0;
    border-radius: 1.25rem;
    overflow: hidden;
    background: var(--ux-surface-2);
    box-shadow: var(--ux-shadow-lg);
    will-change: transform;
  }

  .fan__card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Center — relative anchor */
  .fan__card--2 {
    position: relative;
    z-index: 2;
    width: min(100%, 25rem);
    aspect-ratio: 400 / 550;
    transform: translate3d(0, var(--fan-y), 0);
  }

  /* Left / right — absolute, parked like Webflow inset ±4% + margin-top */
  .fan__card--1,
  .fan__card--3 {
    position: absolute;
    top: 0;
    z-index: 1;
    width: min(40%, 25rem);
    aspect-ratio: 400 / 550;
    margin-top: clamp(2.5rem, 6vw, 6.25rem);
  }

  .fan__card--1 {
    left: -4%;
    transform: translate3d(0, var(--fan-y), 0) rotate(calc(var(--fan-rot) * -1deg));
  }

  .fan__card--3 {
    right: -4%;
    transform: translate3d(0, var(--fan-y), 0) rotate(calc(var(--fan-rot) * 1deg));
  }

  @media (max-width: 61.99rem) {
    .fan {
      height: clamp(16rem, 58vw, 28rem);
    }

    .fan__card--2 {
      width: min(100%, 15rem);
    }

    .fan__card--1,
    .fan__card--3 {
      width: 40%;
      max-width: 15rem;
    }
  }

  @media (max-width: 47.99rem) {
    .fan {
      height: 25rem;
    }

    .fan__card--2 {
      width: 10.625rem;
    }

    .fan__card--1,
    .fan__card--3 {
      max-width: 10.625rem;
      margin-top: 3.75rem;
    }
  }

  @media (max-width: 29.99rem) {
    .fan {
      height: 17rem;
      margin-top: 3.75rem;
    }

    .fan__card--2 {
      width: 7.5rem;
    }

    .fan__card--1,
    .fan__card--3 {
      max-width: 7.5rem;
      margin-top: 2.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fan__card--1 {
      transform: rotate(-12deg);
    }

    .fan__card--2 {
      transform: none;
    }

    .fan__card--3 {
      transform: rotate(12deg);
    }
  }
</style>
