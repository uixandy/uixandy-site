---
/**
 * uixandy logo, paths from the official `uixandy-next-black.svg`.
 * tone="color" = brand gradient (navy to teal), tone="white" = currentColor on dark.
 * animate = the two right arms of the X slide in once on load (replaces the old Lottie).
 */
export interface Props {
  tone?: "color" | "white";
  markOnly?: boolean;
  animate?: boolean;
  class?: string;
  title?: string;
}

const {
  tone = "color",
  markOnly = false,
  animate = false,
  class: className = "",
  title = "uixandy",
} = Astro.props;

const gid = `ux-grad-${Math.random().toString(36).slice(2, 8)}`;
const fill = tone === "color" ? `url(#${gid})` : "currentColor";
const viewBox = markOnly ? "0 0 123 84" : "0 0 418 84";
---

<svg
  class:list={["logo", { "logo--animate": animate }, className]}
  viewBox={viewBox}
  role="img"
  aria-label={title}
  xmlns="http://www.w3.org/2000/svg"
>
  {
    tone === "color" && (
      <defs>
        <linearGradient
          id={gid}
          gradientUnits="userSpaceOnUse"
          x1="0"
          y1="0"
          x2={markOnly ? 123 : 418}
          y2="84"
        >
          <stop offset="0" stop-color="#004B76" />
          <stop offset="1" stop-color="#00C3A0" />
        </linearGradient>
      </defs>
    )
  }
  <g fill={fill}>
    <path d="M57.54 0.199997H38.05L70.7 41.65L53.78 62.62L51.31 65.59C47.95 68.76 43 70.34 36.37 70.34C22.91 70.34 16.09 63.71 16.09 50.45V22.21V16.32V0.199997H0.75V16.33V22.22V50.46C0.75 60.55 3.42 71.04 11.93 77.27C16.58 80.73 22.42 82.51 28.16 83.21C36.57 84.3 45.37 84 53.49 81.13C58.54 79.35 62.89 75.99 66.35 72.03C67.93 70.35 89.9 41.85 89.9 41.85L57.54 0.199997Z" />
    <path class="logo__arm logo__arm--low" d="M87.02 61.25L103.35 83.11H122.74L96.42 49.57L87.02 61.25Z" />
    <path class="logo__arm logo__arm--high" d="M86.73 22.07L96.32 33.84L122.74 0.199997H103.35L86.73 22.07Z" />
    {
      !markOnly && (
        <g class="logo__word">
          <path d="M125.72 46.45V20.33H133.68V46.45C133.68 53.31 137.2 56.74 144.22 56.74C151.24 56.74 154.76 53.31 154.76 46.45V20.33H162.72V46.45C162.72 57.93 156.56 63.66 144.22 63.66C131.88 63.66 125.72 57.93 125.72 46.45Z" />
          <path d="M180.94 20.34V63.37H172.98V20.34H180.94Z" />
          <path d="M204.37 41.85L187.44 20.34H197.52L209.4 36.05L221.28 20.34H231.36L214.46 41.85L231.36 63.36H221.28L209.4 47.65L197.52 63.36H187.44L204.37 41.85Z" />
          <path d="M242.06 63.36H233.88L252.14 20.33H260.72L279.38 63.36H270.8L265.9 51.62H251.6L254.34 44.7H263L256.22 28.55L242.06 63.36Z" />
          <path d="M285.86 63.36V20.33H293.82L316.54 51.68V20.33H324.22V63.36H316.24L293.52 31.35V63.36H285.86Z" />
          <path d="M334.48 63.36V20.33H351.32C365.56 20.33 372.68 27.12 372.68 40.67C372.68 55.79 365.56 63.36 351.32 63.36H334.48ZM351.32 56.45C360.25 56.45 364.71 51.19 364.71 40.68C364.71 31.73 360.25 27.27 351.32 27.27H342.44V56.45H351.32Z" />
          <path d="M376.94 20.34H385.5L397.59 41.08L408.97 20.34H417.25L401.42 48.33V63.37H393.44V48.33L376.94 20.34Z" />
        </g>
      )
    }
  </g>
</svg>

<style>
  .logo {
    display: block;
    height: auto;
    overflow: visible;
  }

  .logo__arm {
    transition: transform var(--ux-dur) var(--ux-ease);
  }

  a:hover > .logo .logo__arm--high,
  a:focus-visible > .logo .logo__arm--high {
    transform: translate(3px, -2px);
  }

  a:hover > .logo .logo__arm--low,
  a:focus-visible > .logo .logo__arm--low {
    transform: translate(3px, 2px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .logo--animate .logo__arm {
      animation: logo-arm-in 700ms var(--ux-ease) both;
    }

    .logo--animate .logo__arm--high {
      animation-delay: 120ms;
    }

    .logo--animate .logo__arm--low {
      animation-delay: 240ms;
    }

    .logo--animate .logo__word {
      animation: logo-word-in 700ms var(--ux-ease) 80ms both;
    }
  }

  @keyframes logo-arm-in {
    from {
      opacity: 0;
      transform: translateX(-14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes logo-word-in {
    from {
      opacity: 0;
      transform: translateX(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
