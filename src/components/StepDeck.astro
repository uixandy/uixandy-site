---
/**
 * Sticky stacking deck: one split card per step, cards stack while scrolling.
 * `visual` picks the mock (CMS select); without it the position decides: build, connect, live.
 * Mock UI is decorative (aria-hidden); step copy and tags come from the CMS.
 */
import Icon from "./Icon.astro";

type Visual = "check" | "build" | "connect" | "live" | "pay" | "review";

export interface Props {
  items: { title: string; text: string; example?: string; tags?: string[]; visual?: Visual | string }[];
}

const { items } = Astro.props;
const fallback: Visual[] = ["build", "connect", "live"];
const tone: Record<Visual, string> = {
  check: "sky",
  build: "mint",
  connect: "sky",
  live: "ink",
  pay: "mint",
  review: "ink",
};
const cards = items.map((item, i) => {
  const visual = (item.visual && item.visual in tone ? item.visual : fallback[i % 3]) as Visual;
  return { ...item, visual, tone: tone[visual] };
});
---

<ol class="deck">
  {
    cards.map((item, i) => (
      <li class="deck__card" style={`--i: ${i}`}>
        <div class="deck__copy">
          <span class="deck__num">{String(i + 1).padStart(2, "0")}</span>
          <h3 class="deck__title">{item.title}</h3>
          <p class="deck__text">{item.text}</p>
          {item.example && <p class="deck__example">{item.example}</p>}
        </div>

        <div class={`deck__visual deck__visual--${item.tone}`} aria-hidden="true">
          {item.visual === "check" && (
            <div class="mk mk-card mk-check">
              <p class="mk-check__step">Frage 2 von 4</p>
              <span class="mk-check__bar"><i /></span>
              <p class="mk-check__q">Wie viele Seiten brauchen Sie?</p>
              <ul>
                <li class="is-picked"><Icon name="check" size={12} /> Bis zu 6 Seiten</li>
                <li>7 bis 15 Seiten</li>
                <li>Weiß ich noch nicht</li>
              </ul>
            </div>
          )}
          {item.visual === "pay" && (
            <div class="mk mk-card mk-pay">
              <p class="mk-pay__label">Ihr Paket</p>
              <p class="mk-pay__big">50 % Anzahlung</p>
              <p class="mk-pay__sub">Rest erst nach Abnahme</p>
              <span class="mk-pay__btn">Jetzt starten</span>
              <span class="mk-pay__btn mk-pay__btn--ghost">Erst 30 Min. sprechen</span>
            </div>
          )}
          {item.visual === "review" && (
            <div class="mk mk-review">
              <p class="mk-review__head"><Icon name="checkCircle" size={18} /> Prüfung Ihres Projekts</p>
              <ul>
                <li><Icon name="check" size={12} /> Umfang passt zum Paket</li>
                <li><Icon name="check" size={12} /> Funktionen geklärt</li>
                <li><Icon name="check" size={12} /> Start freigegeben</li>
              </ul>
            </div>
          )}
          {item.visual === "build" && (
            <div class="mk mk-build">
              <div class="mk-build__chrome">
                <span /><span /><span />
                <em>ihre-firma.de</em>
              </div>
              <div class="mk-build__body">
                <div class="mk-build__nav"><b /><i /><i /><i /></div>
                <div class="mk-build__hero"><b /><i /><span /></div>
                <div class="mk-build__cards"><span /><span /><span /></div>
              </div>
            </div>
          )}
          {item.visual === "connect" && (
            <div class="mk mk-link">
              <div class="mk-link__node">
                <span class="mk-link__icon mk-link__icon--ai"><Icon name="sparkle" size={22} /></span>
                Ihre KI
              </div>
              <div class="mk-link__wire"><span /></div>
              <div class="mk-link__node">
                <span class="mk-link__icon"><Icon name="globe" size={22} /></span>
                Ihre Website
              </div>
              <p class="mk-link__status"><Icon name="check" size={14} /> Verbunden</p>
            </div>
          )}
          {item.visual === "live" && (
            <div class="mk mk-live">
              <p class="mk-live__msg">{item.example || "Bitte das Teamfoto austauschen."}</p>
              <div class="mk-live__reply">
                <span class="mk-live__dot" />
                <span class="mk-line mk-line--80" />
                <span class="mk-line mk-line--55" />
              </div>
              <ul class="mk-live__versions">
                <li class="is-current"><Icon name="check" size={12} /> Neue Version <em>live</em></li>
                <li>Version von gestern</li>
                <li>Version von letzter Woche</li>
              </ul>
            </div>
          )}

          {item.tags?.slice(0, 2).map((tag, t) => (
            <span class={`deck__tag deck__tag--${t + 1} ${t % 2 ? "ux-float-alt" : "ux-float"}`}>{tag}</span>
          ))}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .deck {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--ux-space-5);
  }

  .deck__card {
    position: sticky;
    top: calc(var(--ux-header-h) + var(--ux-space-5) + var(--i, 0) * 1.25rem);
    display: grid;
    gap: var(--ux-space-4);
    padding: var(--ux-space-3);
    border-radius: calc(var(--ux-radius-lg) + 0.5rem);
    background: var(--ux-bg);
    border: 1px solid var(--ux-border);
    box-shadow: 0 -10px 40px -20px rgb(0 33 53 / 0.18);
  }

  .deck__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--ux-space-4);
    padding: var(--ux-space-5) var(--ux-space-4) var(--ux-space-3);
  }

  .deck__num {
    font-family: var(--ux-font-display);
    font-size: clamp(2.5rem, 2rem + 2vw, 3.75rem);
    line-height: 1;
    background: var(--ux-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .deck__title {
    font-size: var(--ux-text-2xl);
    color: var(--ux-navy-deep);
  }

  .deck__text {
    color: var(--ux-muted);
    max-width: 26rem;
  }

  .deck__example {
    margin-top: auto;
    padding: 10px 16px;
    border-radius: 16px 16px 16px 4px;
    background: var(--ux-surface-2);
    color: var(--ux-navy-deep);
    font-weight: 700;
    font-size: var(--ux-text-sm);
  }

  /* Visual panel */

  .deck__visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 20rem;
    padding: var(--ux-space-7) var(--ux-space-5);
    border-radius: var(--ux-radius-lg);
    overflow: hidden;
    isolation: isolate;
  }

  .deck__visual--mint {
    background:
      radial-gradient(26rem 16rem at 85% 10%, rgb(0 195 160 / 0.32), transparent 70%),
      linear-gradient(160deg, #e6f7f3, #d3efe9);
  }

  .deck__visual--sky {
    background:
      radial-gradient(26rem 16rem at 15% 90%, rgb(0 75 118 / 0.22), transparent 70%),
      linear-gradient(160deg, #eaf2f7, #d7e6ef);
  }

  .deck__visual--ink {
    background:
      radial-gradient(28rem 18rem at 90% 0%, rgb(0 195 160 / 0.4), transparent 65%),
      radial-gradient(24rem 16rem at 0% 100%, rgb(0 75 118 / 0.8), transparent 65%),
      var(--ux-navy-deep);
  }

  .deck__tag {
    position: absolute;
    z-index: 2;
    padding: 0.55rem 0.9rem;
    border-radius: 0.8rem;
    background: rgb(255 255 255 / 0.95);
    color: var(--ux-navy-deep);
    font-size: var(--ux-text-xs);
    font-weight: 700;
    white-space: nowrap;
    box-shadow: var(--ux-shadow-md);
  }

  .deck__tag--1 { top: 10%; left: 6%; }
  .deck__tag--2 { bottom: 9%; right: 6%; animation-delay: 0.8s; }

  /* White card mocks: check, pay */

  .mk-card {
    width: min(100%, 19rem);
    padding: 16px;
    border-radius: var(--ux-radius-md);
    background: var(--ux-bg);
    color: var(--ux-navy-deep);
    box-shadow: var(--ux-shadow-lg);
    font-size: var(--ux-text-xs);
  }

  .mk-check__step {
    color: var(--ux-muted);
  }

  .mk-check__bar {
    display: block;
    height: 6px;
    margin: 8px 0 14px;
    border-radius: 99px;
    background: var(--ux-surface-2);
    overflow: hidden;
  }

  .mk-check__bar i {
    display: block;
    width: 50%;
    height: 100%;
    border-radius: inherit;
    background: var(--ux-gradient);
  }

  .mk-check__q {
    font-family: var(--ux-font-display);
    font-size: var(--ux-text-base);
    margin-bottom: 10px;
  }

  .mk-check ul,
  .mk-review ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }

  .mk-check li {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 10px;
    border-radius: 9px;
    border: 1.5px solid var(--ux-border);
    font-weight: 700;
  }

  .mk-check li.is-picked {
    border-color: var(--ux-teal);
    background: rgb(0 195 160 / 0.1);
  }

  .mk-check li.is-picked :global(.icon) {
    color: var(--ux-teal-ink);
  }

  .mk-pay__label {
    color: var(--ux-muted);
  }

  .mk-pay__big {
    margin-top: 4px;
    font-family: var(--ux-font-display);
    font-size: var(--ux-text-xl);
  }

  .mk-pay__sub {
    margin-bottom: 14px;
    color: var(--ux-muted);
  }

  .mk-pay__btn {
    display: block;
    padding: 9px 12px;
    border-radius: 99px;
    background: var(--ux-navy);
    color: var(--ux-on-dark);
    font-weight: 700;
    text-align: center;
  }

  .mk-pay__btn--ghost {
    margin-top: 6px;
    background: transparent;
    border: 1.5px solid var(--ux-border);
    color: var(--ux-navy-deep);
  }

  /* Dark mock: review */

  .mk-review {
    width: min(100%, 19rem);
    padding: 16px;
    border-radius: var(--ux-radius-md);
    background: rgb(255 255 255 / 0.06);
    border: 1px solid var(--ux-border-dark);
    color: var(--ux-on-dark);
    font-size: var(--ux-text-sm);
  }

  .mk-review__head {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    font-weight: 700;
  }

  .mk-review__head :global(.icon) {
    color: var(--ux-teal);
  }

  .mk-review li {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 12px;
    border-radius: 10px;
    background: rgb(255 255 255 / 0.05);
    color: var(--ux-on-dark-muted);
  }

  .mk-review li :global(.icon) {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    padding: 4px;
    border-radius: 50%;
    background: var(--ux-teal);
    color: var(--ux-navy-deep);
  }

  /* Shared mock primitives */

  .mk {
    position: relative;
    z-index: 1;
    width: min(100%, 22rem);
    transition: transform 0.6s var(--ux-ease-out);
  }

  .deck__card:hover .mk {
    transform: translateY(-6px) scale(1.02);
  }

  .mk-line {
    display: block;
    height: 0.5rem;
    border-radius: 99px;
    background: rgb(255 255 255 / 0.22);
  }

  .mk-line--80 { width: 80%; }
  .mk-line--55 { width: 55%; }

  /* 01: website being built */

  .mk-build {
    border-radius: var(--ux-radius-md);
    background: var(--ux-bg);
    box-shadow: var(--ux-shadow-lg);
    overflow: hidden;
  }

  .mk-build__chrome {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 9px 12px;
    background: var(--ux-surface);
    border-bottom: 1px solid var(--ux-border);
  }

  .mk-build__chrome > span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ux-border);
  }

  .mk-build__chrome em {
    margin-left: 8px;
    padding: 2px 10px;
    border-radius: 99px;
    background: var(--ux-bg);
    font-style: normal;
    font-size: 11px;
    color: var(--ux-muted);
  }

  .mk-build__body {
    display: grid;
    gap: 10px;
    padding: 14px;
  }

  .mk-build__nav {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .mk-build__nav b {
    width: 54px;
    height: 10px;
    margin-right: auto;
    border-radius: 4px;
    background: var(--ux-navy);
  }

  .mk-build__nav i {
    width: 26px;
    height: 6px;
    border-radius: 3px;
    background: var(--ux-surface-2);
  }

  .mk-build__hero {
    display: grid;
    gap: 7px;
    padding: 18px 16px;
    border-radius: 10px;
    background: var(--ux-gradient);
  }

  .mk-build__hero b {
    width: 70%;
    height: 12px;
    border-radius: 4px;
    background: rgb(255 255 255 / 0.9);
  }

  .mk-build__hero i {
    width: 50%;
    height: 7px;
    border-radius: 4px;
    background: rgb(255 255 255 / 0.5);
  }

  .mk-build__hero span {
    width: 64px;
    height: 18px;
    margin-top: 4px;
    border-radius: 99px;
    background: var(--ux-bg);
  }

  .mk-build__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .mk-build__cards span {
    height: 44px;
    border-radius: 8px;
    background: var(--ux-surface);
    border: 1px solid var(--ux-border);
  }

  /* 02: AI gets connected */

  .mk-link {
    display: grid;
    grid-template-columns: 1fr minmax(2.5rem, 1fr) 1fr;
    align-items: center;
    gap: 10px;
    width: min(100%, 22rem);
  }

  .mk-link__node {
    display: grid;
    justify-items: center;
    gap: 8px;
    width: 100%;
    min-height: 6.5rem;
    padding: 14px 12px;
    border-radius: var(--ux-radius-md);
    background: var(--ux-bg);
    box-shadow: var(--ux-shadow-md);
    font-size: var(--ux-text-xs);
    font-weight: 700;
    color: var(--ux-navy-deep);
    box-sizing: border-box;
  }

  .mk-link__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--ux-surface-2);
    color: var(--ux-navy);
  }

  .mk-link__icon--ai {
    background: var(--ux-gradient);
    color: var(--ux-on-dark);
  }

  .mk-link__wire {
    position: relative;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--ux-navy) 0 6px, transparent 6px 12px);
    opacity: 0.6;
  }

  .mk-link__wire span {
    position: absolute;
    top: 50%;
    left: 0;
    width: 10px;
    height: 10px;
    margin-top: -5px;
    border-radius: 50%;
    background: var(--ux-teal);
    box-shadow: 0 0 0 4px rgb(0 195 160 / 0.25);
  }

  .mk-link__status {
    grid-column: 1 / -1;
    justify-self: center;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
    padding: 5px 12px;
    border-radius: 99px;
    background: var(--ux-teal);
    color: var(--ux-on-dark);
    font-size: var(--ux-text-xs);
    font-weight: 700;
  }

  /* 03: change goes live */

  .mk-live {
    display: grid;
    gap: 10px;
    padding: 14px;
    border-radius: var(--ux-radius-md);
    background: rgb(255 255 255 / 0.06);
    border: 1px solid var(--ux-border-dark);
    backdrop-filter: blur(6px);
  }

  .mk-live__msg {
    justify-self: end;
    max-width: 88%;
    padding: 9px 12px;
    border-radius: 14px 14px 4px 14px;
    background: var(--ux-teal);
    color: var(--ux-navy-deep);
    font-size: var(--ux-text-sm);
    font-weight: 700;
  }

  .mk-live__reply {
    display: grid;
    gap: 7px;
    width: 78%;
    padding: 12px;
    border-radius: 14px 14px 14px 4px;
    background: rgb(255 255 255 / 0.08);
  }

  .mk-live__dot {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--ux-gradient);
  }

  .mk-live__versions {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: grid;
    gap: 6px;
    font-size: var(--ux-text-xs);
    color: var(--ux-on-dark-muted);
  }

  .mk-live__versions li {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 7px 10px;
    border-radius: 9px;
    background: rgb(255 255 255 / 0.04);
  }

  .mk-live__versions li.is-current {
    background: rgb(0 195 160 / 0.16);
    color: var(--ux-on-dark);
    font-weight: 700;
  }

  .mk-live__versions em {
    margin-left: auto;
    font-style: normal;
    color: var(--ux-teal);
  }

  @media (prefers-reduced-motion: no-preference) {
    .mk-build__nav,
    .mk-build__hero,
    .mk-build__cards span {
      animation: mk-assemble 6s var(--ux-ease-out) infinite both;
    }

    .mk-build__hero { animation-delay: 0.25s; }
    .mk-build__cards span:nth-child(1) { animation-delay: 0.5s; }
    .mk-build__cards span:nth-child(2) { animation-delay: 0.65s; }
    .mk-build__cards span:nth-child(3) { animation-delay: 0.8s; }

    .mk-link__wire span {
      animation: mk-travel 2.4s var(--ux-ease) infinite;
    }

    .mk-live__versions li.is-current {
      animation: mk-glow 3s ease-in-out infinite;
    }

    .mk-check__bar i {
      animation: mk-progress 4s var(--ux-ease-out) infinite;
    }

    .mk-review li {
      animation: mk-tick 5s var(--ux-ease-out) infinite both;
    }

    .mk-review li:nth-child(2) { animation-delay: 0.35s; }
    .mk-review li:nth-child(3) { animation-delay: 0.7s; }
  }

  @keyframes mk-progress {
    0% { width: 25%; }
    30%, 100% { width: 50%; }
  }

  @keyframes mk-tick {
    0% { opacity: 0.25; translate: -6px 0; }
    10%, 90% { opacity: 1; translate: 0 0; }
    100% { opacity: 0.25; }
  }

  @keyframes mk-assemble {
    0% { opacity: 0; translate: 0 10px; }
    12%, 85% { opacity: 1; translate: 0 0; }
    100% { opacity: 0; translate: 0 -4px; }
  }

  @keyframes mk-travel {
    0% { left: 0; opacity: 0; }
    15% { opacity: 1; }
    85% { opacity: 1; }
    100% { left: calc(100% - 10px); opacity: 0; }
  }

  @keyframes mk-glow {
    50% { background: rgb(0 195 160 / 0.3); }
  }

  @media (min-width: 52rem) {
    .deck__card {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      min-height: 26rem;
    }

    .deck__copy {
      padding: var(--ux-space-6) var(--ux-space-5) var(--ux-space-6) var(--ux-space-6);
    }

    .deck__visual {
      min-height: 0;
    }
  }

  @media (max-width: 40rem) {
    .deck__card {
      position: static;
    }
  }
</style>
