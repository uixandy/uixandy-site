---
export interface Props {
  items: { title: string; text: string; example?: string }[];
}

const { items } = Astro.props;
---

<ol class="steps" data-reveal-stagger>
  {
    items.map((item, i) => (
      <li class="step">
        <span class="step__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
        <h3 class="step__title">{item.title}</h3>
        <p class="step__text">{item.text}</p>
        {item.example && <p class="step__example">{item.example}</p>}
      </li>
    ))
  }
</ol>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--ux-space-6);
    counter-reset: step;
  }

  .step {
    position: relative;
    padding-top: var(--ux-space-6);
    border-top: 1px solid var(--ux-border);
  }

  .step::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 0;
    width: 3rem;
    height: 3px;
    border-radius: 3px;
    background: var(--ux-gradient);
  }

  .step__num {
    display: block;
    margin-bottom: var(--ux-space-4);
    font-family: var(--ux-font-display);
    font-size: var(--ux-text-2xl);
    line-height: 1;
    color: var(--ux-teal-ink);
  }

  .step__title {
    margin-bottom: var(--ux-space-3);
  }

  .step__text {
    color: var(--ux-muted);
  }

  .step__example {
    margin-top: var(--ux-space-4);
    padding: var(--ux-space-3) var(--ux-space-4);
    border-radius: var(--ux-radius-md);
    border-bottom-right-radius: 4px;
    background: var(--ux-teal);
    color: var(--ux-navy-deep);
    font-size: var(--ux-text-sm);
    font-weight: 700;
    width: fit-content;
    max-width: 100%;
  }

  @media (min-width: 56rem) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--ux-space-7);
    }
  }
</style>
