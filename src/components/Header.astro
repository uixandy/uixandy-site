---
import site from "../data/site.json";
import Logo from "./Logo.astro";
import Button from "./Button.astro";

const path = Astro.url.pathname;
const isActive = (href: string) => href !== "/" && path.startsWith(href);
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo" aria-label="uixandy Startseite">
      <Logo tone="white" animate />
    </a>

    <nav class="site-nav" aria-label="Hauptnavigation">
      <ul class="site-nav__list">
        {
          site.nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="site-nav__link"
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <Button href={site.primaryCta.href} variant="light">{site.primaryCta.label}</Button>
    </nav>

    <button
      class="site-header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Menü öffnen"
      data-menu-toggle
    >
      <span class="burger" aria-hidden="true">
        <i></i>
        <i></i>
        <i></i>
      </span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-menu hidden inert>
    <ul class="mobile-menu__list">
      {
        site.nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mobile-menu__cta">
      <Button href={site.primaryCta.href} variant="light" size="lg" arrow>
        {site.primaryCta.label} starten
      </Button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-menu]");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

  const setOpen = (open: boolean) => {
    if (!toggle || !menu || !header) return;
    const wasOpen = toggle.getAttribute("aria-expanded") === "true";
    if (open === wasOpen) return;

    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Menü schließen" : "Menü öffnen");
    document.documentElement.style.overflow = open ? "hidden" : "";

    if (open) {
      menu.hidden = false;
      menu.removeAttribute("inert");
      requestAnimationFrame(() => {
        requestAnimationFrame(() => header.classList.add("is-open"));
      });
      return;
    }

    header.classList.remove("is-open");
    menu.setAttribute("inert", "");

    const finish = () => {
      if (toggle.getAttribute("aria-expanded") === "true") return;
      menu.hidden = true;
    };

    if (reduced.matches) {
      finish();
      return;
    }

    const onEnd = (e: TransitionEvent) => {
      if (e.target !== menu || e.propertyName !== "opacity") return;
      menu.removeEventListener("transitionend", onEnd);
      finish();
    };
    menu.addEventListener("transitionend", onEnd);
  };

  toggle?.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (e) => e.key === "Escape" && setOpen(false));
  window.matchMedia("(min-width: 64rem)").addEventListener("change", (e) => e.matches && setOpen(false));

  const onScroll = () => header?.classList.toggle("is-scrolled", window.scrollY > 8);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--ux-navy-deep);
    color: var(--ux-on-dark);
    transition: box-shadow var(--ux-dur) var(--ux-ease);
  }

  .site-header.is-scrolled {
    box-shadow: 0 8px 28px -14px rgb(0 33 53 / 0.6);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ux-space-5);
    height: var(--ux-header-h);
  }

  .site-header__logo {
    display: block;
    width: 9.5rem;
    color: var(--ux-on-dark);
  }

  .site-header__logo:hover {
    color: var(--ux-on-dark);
  }

  .site-nav {
    display: none;
    align-items: center;
    gap: var(--ux-space-6);
  }

  .site-nav__list {
    display: flex;
    gap: var(--ux-space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav__link {
    position: relative;
    color: var(--ux-on-dark);
    font-weight: 700;
    font-size: var(--ux-text-sm);
    text-decoration: none;
    padding-block: var(--ux-space-2);
  }

  .site-nav__link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--ux-gradient);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--ux-dur) var(--ux-ease);
  }

  .site-nav__link:hover,
  .site-nav__link[aria-current="page"] {
    color: var(--ux-teal);
  }

  .site-nav__link:hover::after,
  .site-nav__link[aria-current="page"]::after {
    transform: scaleX(1);
  }

  .site-header__toggle {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: var(--ux-radius-sm);
    background: transparent;
    color: var(--ux-on-dark);
    cursor: pointer;
  }

  .burger {
    display: grid;
    gap: 5px;
    width: 1.35rem;
  }

  .burger i {
    display: block;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    transform-origin: center;
    transition:
      transform var(--ux-dur) var(--ux-ease-out),
      opacity var(--ux-dur-fast) var(--ux-ease);
  }

  .site-header.is-open .burger i:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .site-header.is-open .burger i:nth-child(2) {
    opacity: 0;
    transform: scaleX(0.4);
  }

  .site-header.is-open .burger i:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: var(--ux-header-h) 0 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--ux-space-7);
    padding: var(--ux-space-6);
    background: var(--ux-navy-deep);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-0.6rem);
    transition:
      opacity var(--ux-dur) var(--ux-ease-out),
      transform var(--ux-dur) var(--ux-ease-out),
      visibility 0s linear var(--ux-dur);
  }

  .site-header.is-open .mobile-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: none;
    transition:
      opacity var(--ux-dur) var(--ux-ease-out),
      transform var(--ux-dur) var(--ux-ease-out),
      visibility 0s linear 0s;
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu__list {
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: center;
    display: grid;
    gap: var(--ux-space-5);
  }

  .mobile-menu__list li,
  .mobile-menu__cta {
    opacity: 0;
    transform: translateY(0.85rem);
    transition:
      opacity var(--ux-dur) var(--ux-ease-out),
      transform var(--ux-dur) var(--ux-ease-out);
  }

  .site-header.is-open .mobile-menu__list li,
  .site-header.is-open .mobile-menu__cta {
    opacity: 1;
    transform: none;
  }

  .site-header.is-open .mobile-menu__list li:nth-child(1) { transition-delay: 50ms; }
  .site-header.is-open .mobile-menu__list li:nth-child(2) { transition-delay: 90ms; }
  .site-header.is-open .mobile-menu__list li:nth-child(3) { transition-delay: 130ms; }
  .site-header.is-open .mobile-menu__list li:nth-child(4) { transition-delay: 170ms; }
  .site-header.is-open .mobile-menu__list li:nth-child(5) { transition-delay: 210ms; }
  .site-header.is-open .mobile-menu__list li:nth-child(6) { transition-delay: 250ms; }
  .site-header.is-open .mobile-menu__cta { transition-delay: 280ms; }

  .mobile-menu__list a {
    font-family: var(--ux-font-display);
    font-size: var(--ux-text-2xl);
    color: var(--ux-on-dark);
    text-decoration: none;
  }

  .mobile-menu__list a[aria-current="page"] {
    color: var(--ux-teal);
  }

  @media (prefers-reduced-motion: reduce) {
    .burger i,
    .mobile-menu,
    .site-header.is-open .mobile-menu,
    .mobile-menu__list li,
    .mobile-menu__cta,
    .site-header.is-open .mobile-menu__list li,
    .site-header.is-open .mobile-menu__cta {
      transition: none;
      transition-delay: 0s;
    }

    .mobile-menu {
      transform: none;
    }

    .mobile-menu__list li,
    .mobile-menu__cta {
      transform: none;
    }
  }

  @media (min-width: 64rem) {
    .site-nav {
      display: flex;
    }

    .site-header__toggle,
    .mobile-menu {
      display: none !important;
    }
  }
</style>
