---
import Icon from "./Icon.astro";

export interface Props {
  items: { question: string; answer: string }[];
}

const { items } = Astro.props;
---

<div class="faq" data-reveal-stagger>
  {
    items.map((item) => (
      <details class="faq__item">
        <summary>
          <span>{item.question}</span>
          <Icon name="caretDown" size={20} class="faq__caret" />
        </summary>
        <p set:html={item.answer} />
      </details>
    ))
  }
</div>

<style>
  .faq {
    display: grid;
    gap: var(--ux-space-3);
  }

  .faq__item {
    border-radius: var(--ux-radius-md);
    background: var(--ux-bg);
    border: 1px solid var(--ux-border);
    transition: border-color var(--ux-dur-fast) var(--ux-ease);
  }

  .faq__item[open] {
    border-color: var(--ux-teal);
  }

  .faq__item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--ux-space-4);
    padding: var(--ux-space-5);
    font-weight: 700;
    font-size: var(--ux-text-lg);
    line-height: var(--ux-leading-snug);
    cursor: pointer;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary:hover {
    color: var(--ux-navy);
  }

  .faq__item :global(.faq__caret) {
    color: var(--ux-teal-ink);
    transition: transform var(--ux-dur) var(--ux-ease);
  }

  .faq__item[open] :global(.faq__caret) {
    transform: rotate(180deg);
  }

  .faq__item p {
    padding: 0 var(--ux-space-5) var(--ux-space-5);
    color: var(--ux-muted);
    max-width: 48rem;
  }
</style>
