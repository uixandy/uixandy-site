---
/**
 * Demo video. Empty `src` = placeholder panel (until the real screen recording exists).
 * `src` = self-hosted MP4 under /media/ (no YouTube embed = no cookie banner needed).
 */
import Icon from "./Icon.astro";

export interface Props {
  src?: string;
  poster?: string;
  placeholderText: string;
  caption?: string;
}

const { src, poster, placeholderText, caption } = Astro.props;
---

<figure class="video" data-reveal>
  {
    src ? (
      <video controls playsinline preload="metadata" poster={poster || undefined}>
        <source src={src} type="video/mp4" />
      </video>
    ) : (
      <div class="video__placeholder">
        <Icon name="play" size={64} />
        <p>{placeholderText}</p>
      </div>
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .video {
    margin: 0;
  }

  .video video,
  .video__placeholder {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--ux-radius-lg);
    background: var(--ux-navy-deep);
    box-shadow: var(--ux-shadow-lg);
  }

  .video__placeholder {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--ux-space-4);
    padding: var(--ux-space-6);
    text-align: center;
    color: var(--ux-on-dark-muted);
    background:
      radial-gradient(30rem 20rem at 80% 10%, rgb(0 195 160 / 0.35), transparent 60%),
      var(--ux-navy-deep);
    border: 2px dashed rgb(0 195 160 / 0.5);
  }

  .video__placeholder :global(.icon) {
    color: var(--ux-teal);
  }

  .video__placeholder p {
    max-width: 28rem;
  }

  figcaption {
    margin-top: var(--ux-space-4);
    text-align: center;
    font-size: var(--ux-text-sm);
    color: var(--ux-muted);
  }
</style>
