---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/Section.astro";
import SectionHead from "../components/SectionHead.astro";
import Comparison from "../components/Comparison.astro";
import FeatureCards from "../components/FeatureCards.astro";
import Faq from "../components/Faq.astro";
import CtaBand from "../components/CtaBand.astro";
import CtaInline from "../components/CtaInline.astro";
import page from "../data/pages/wordpress-alternative.json";
import site from "../data/site.json";
import { resolveSeo } from "../lib/seo";
import { faqJsonLd } from "../lib/jsonld";

const seo = resolveSeo(page);
---

<BaseLayout title={seo.title} description={seo.description} ogImage={seo.ogImage} jsonLd={faqJsonLd(page.faq.items)}>
  <PageHero
    kicker={page.hero.kicker}
    heading={page.hero.heading}
    lead={page.hero.lead}
    primary={{ label: page.cta.primaryLabel, href: site.primaryCta.href }}
    secondary={site.secondaryCta}
  />

  <Section flush="top" narrow>
    <aside class="answer" data-reveal>
      <p class="answer__label">{page.answer.heading}</p>
      <p>{page.answer.text}</p>
    </aside>
  </Section>

  <Section id="vergleich">
    <SectionHead kicker={page.compare.kicker} heading={page.compare.heading} />
    <Comparison oldLabel={page.compare.oldLabel} newLabel={page.compare.newLabel} rows={page.compare.rows} />
    <CtaInline
      text={page.nudge.text}
      primary={{ label: page.cta.primaryLabel, href: site.primaryCta.href }}
      link={{ label: page.nudge.linkLabel, href: site.booking.calUrl }}
    />
  </Section>

  <Section id="wann-wordpress" tone="soft">
    <SectionHead kicker={page.fit.kicker} heading={page.fit.heading} lead={page.fit.lead} />
    <FeatureCards items={page.fit.items} />
  </Section>

  <Section id="faq" narrow>
    <SectionHead kicker={page.faq.kicker} heading={page.faq.heading} align="center" />
    <Faq items={page.faq.items} />
  </Section>

  <CtaBand
    heading={page.cta.heading}
    text={page.cta.text}
    primary={{ label: page.cta.primaryLabel, href: site.primaryCta.href }}
    secondary={{ label: page.cta.secondaryLabel, href: site.booking.calUrl }}
  />
</BaseLayout>

<style>
  .answer {
    padding: var(--ux-space-6);
    border-radius: var(--ux-radius-lg);
    background: var(--ux-surface);
    border-left: 4px solid var(--ux-teal);
    font-size: var(--ux-text-lg);
  }

  .answer__label {
    margin-bottom: var(--ux-space-3);
    font-family: var(--ux-font-display);
    color: var(--ux-navy);
  }
</style>
