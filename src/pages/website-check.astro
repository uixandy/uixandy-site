---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import page from "../data/pages/website-check.json";
import site from "../data/site.json";
import packages from "../data/packages.json";
import { resolveSeo } from "../lib/seo";

const seo = resolveSeo(page);
const { form, results } = page;
const pkg = Object.fromEntries(packages.items.map((p) => [p.id, p]));
const outcomes = [
  { id: "start", ...results.start, pkg: pkg.start, stripe: site.booking.stripeStart },
  { id: "individuell", ...results.individuell, pkg: pkg.individuell, stripe: site.booking.stripeIndividuell },
  { id: "gespraech", ...results.gespraech, pkg: pkg.individuell, stripe: "" },
];
const TOTAL = 5;
---

<BaseLayout title={seo.title} description={seo.description} ogImage={seo.ogImage}>
  <PageHero kicker={page.hero.kicker} heading={page.hero.heading} lead={page.hero.lead} />

  <Section flush="top" narrow>
    <div class="wiz" data-wiz>
      <div class="wiz__progress" aria-hidden="true">
        <span class="wiz__bar"><i data-bar /></span>
        <span class="wiz__count" data-count data-template={form.progressLabel} data-total={TOTAL}></span>
      </div>

      <form
        class="check"
        data-check
        action={site.booking.formEndpoint}
        method="POST"
        novalidate
        data-error-text={form.errorText}
      >
        <input type="hidden" name="_subject" value="Neuer Website-Check (uixandy.com)" />
        <input type="hidden" name="interesse" value="" data-interest />
        <input type="hidden" name="empfehlung" value="" data-recommendation />
        <p class="check__hp" aria-hidden="true">
          <label>Nicht ausfüllen <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
        </p>

        <fieldset class="step" data-step="1">
          <legend class="step__q">{form.websiteLabel}</legend>
          <p class="step__hint">{form.websiteHint}</p>
          <input class="field field--lg" type="text" name="website" placeholder={form.websitePlaceholder} inputmode="url" autocomplete="url" data-website />
          <div class="step__actions">
            <Button type="button" size="lg" arrow data-next>{form.nextLabel}</Button>
            <button type="button" class="step__link" data-no-website>{form.noWebsiteLabel}</button>
          </div>
        </fieldset>

        <fieldset class="step" data-step="2">
          <legend class="step__q">{form.pagesLabel}</legend>
          <div class="options">
            {
              form.pagesOptions.map((o) => (
                <label class="option">
                  <input type="radio" name="seiten" value={o.value} data-auto />
                  <span>{o.label}<Icon name="arrowRight" size={18} /></span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <fieldset class="step" data-step="3">
          <legend class="step__q">{form.featuresLabel}</legend>
          <p class="step__hint">{form.featuresHint}</p>
          <div class="options options--grid">
            {
              form.featuresOptions.map((o) => (
                <label class="option option--check">
                  <input type="checkbox" name="funktionen" value={o.value} data-feature />
                  <span><b class="option__box"><Icon name="check" size={12} /></b>{o.label}</span>
                </label>
              ))
            }
          </div>
          <div class="step__actions">
            <Button type="button" size="lg" arrow data-next data-features-next data-none={form.featuresNoneLabel} data-some={form.nextLabel}>
              {form.featuresNoneLabel}
            </Button>
          </div>
        </fieldset>

        <fieldset class="step" data-step="4">
          <legend class="step__q">{form.timingLabel}</legend>
          <div class="options">
            {
              form.timingOptions.map((o) => (
                <label class="option">
                  <input type="radio" name="zeitraum" value={o.value} data-auto />
                  <span>{o.label}<Icon name="arrowRight" size={18} /></span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <fieldset class="step" data-step="5">
          <legend class="step__q">{form.contactLabel}</legend>
          <div class="fields">
            <label class="field-label">
              {form.nameLabel}
              <input class="field" type="text" name="name" autocomplete="name" required />
            </label>
            <label class="field-label">
              {form.emailLabel}
              <input class="field" type="email" name="email" autocomplete="email" required />
            </label>
          </div>
          <details class="more">
            <summary>{form.moreLabel}</summary>
            <div class="fields">
              <label class="field-label fields__full">
                {form.companyLabel}
                <input class="field" type="text" name="firma" autocomplete="organization" />
              </label>
              <label class="field-label fields__full">
                {form.messageLabel}
                <textarea class="field" name="nachricht" rows="3"></textarea>
              </label>
            </div>
          </details>
          <label class="consent">
            <input type="checkbox" name="einwilligung" value="ja" required />
            <span>{form.consentText} Mehr in der <a href="/datenschutz/">Datenschutzerklärung</a>.</span>
          </label>
          <p class="check__error" data-error hidden role="alert"></p>
          <div class="step__actions">
            <Button type="submit" size="lg" arrow data-submit data-sending={form.sendingLabel}>{form.submitLabel}</Button>
          </div>
        </fieldset>

        <button type="button" class="wiz__back" data-back hidden>
          <Icon name="arrowRight" size={16} class="wiz__back-icon" />
          {form.backLabel}
        </button>
      </form>
    </div>

    <div class="result" data-result hidden tabindex="-1">
      {
        outcomes.map((o) => (
          <article class="result__card" data-outcome={o.id} hidden>
            <p class="result__sent">
              <Icon name="checkCircle" size={20} />
              {results.sentNote}
            </p>
            <h2>{o.title}</h2>
            <p class="result__price">
              {o.pkg.pricePrefix && <span>{o.pkg.pricePrefix}</span>}
              {o.pkg.price}
              <small>netto</small>
            </p>
            <p class="result__text">{o.text}</p>
            <p class="result__shop" data-shop-note hidden>
              <Icon name="storefront" size={20} />
              {results.shopNote}
            </p>
            <div class="result__actions">
              {o.stripe ? (
                <>
                  <Button href={o.stripe} variant="light" size="lg" arrow data-stripe>
                    {results.depositLabel} ({o.pkg.deposit})
                  </Button>
                  <Button href={site.booking.calUrl} variant="ghost-light" size="lg" data-cal>
                    {results.callLabel}
                  </Button>
                </>
              ) : (
                <Button href={site.booking.calUrl} variant="light" size="lg" arrow data-cal>
                  {results.callLabel}
                </Button>
              )}
            </div>
            {o.stripe && <p class="result__note">{results.refundNote}</p>}
          </article>
        ))
      }
    </div>
  </Section>
</BaseLayout>

<script>
  type Outcome = "start" | "individuell" | "gespraech";

  const wiz = document.querySelector<HTMLElement>("[data-wiz]");
  const form = document.querySelector<HTMLFormElement>("[data-check]");
  const result = document.querySelector<HTMLElement>("[data-result]");
  const errorEl = document.querySelector<HTMLElement>("[data-error]");
  const submit = form?.querySelector<HTMLButtonElement>("[data-submit]");
  const submitText = submit?.querySelector("span");
  const submitLabel = submitText?.textContent ?? "";
  const steps = Array.from(form?.querySelectorAll<HTMLFieldSetElement>("[data-step]") ?? []);
  const bar = wiz?.querySelector<HTMLElement>("[data-bar]");
  const count = wiz?.querySelector<HTMLElement>("[data-count]");
  const back = form?.querySelector<HTMLButtonElement>("[data-back]");
  const featuresNext = form?.querySelector<HTMLButtonElement>("[data-features-next]");
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  const INDIVIDUAL = ["blog", "jobs", "sprachen", "termine", "rechner", "formulare"];

  const recommend = (pages: string, features: string[]): Outcome => {
    if (features.includes("login") || pages === "ueber-15" || pages === "unklar") return "gespraech";
    if (pages === "7-15" || features.some((f) => INDIVIDUAL.includes(f))) return "individuell";
    return "start";
  };

  let current = 0;

  const show = (index: number, dir: 1 | -1 = 1) => {
    current = Math.max(0, Math.min(steps.length - 1, index));
    steps.forEach((s, i) => {
      s.classList.toggle("is-active", i === current);
      s.classList.toggle("is-back", i === current && dir === -1);
    });
    const total = Number(count?.dataset.total ?? steps.length);
    if (bar) bar.style.width = `${((current + 1) / total) * 100}%`;
    if (count) {
      count.textContent = (count.dataset.template ?? "")
        .replace("{n}", String(current + 1))
        .replace("{total}", String(total));
    }
    if (back) back.hidden = current === 0;
    const focusable = steps[current]?.querySelector<HTMLElement>("input:not([type=hidden]), button");
    if (index > 0) focusable?.focus({ preventScroll: true });
  };

  if (wiz && form && steps.length) {
    wiz.classList.add("is-wizard");
    show(0);

    form.querySelectorAll<HTMLElement>("[data-next]").forEach((btn) =>
      btn.addEventListener("click", () => show(current + 1)),
    );

    form.querySelector("[data-no-website]")?.addEventListener("click", () => {
      const input = form.querySelector<HTMLInputElement>("[data-website]");
      if (input) input.value = "";
      show(current + 1);
    });

    form.querySelector<HTMLInputElement>("[data-website]")?.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        e.preventDefault();
        show(current + 1);
      }
    });

    form.querySelectorAll<HTMLInputElement>("[data-auto]").forEach((input) =>
      input.addEventListener("click", () => {
        window.setTimeout(() => show(current + 1), reduced ? 0 : 260);
      }),
    );

    form.querySelectorAll<HTMLInputElement>("[data-feature]").forEach((input) =>
      input.addEventListener("change", () => {
        if (!featuresNext) return;
        const some = form.querySelectorAll("[data-feature]:checked").length > 0;
        const label = some ? featuresNext.dataset.some : featuresNext.dataset.none;
        const span = featuresNext.querySelector("span");
        if (span && label) span.textContent = label;
      }),
    );

    back?.addEventListener("click", () => show(current - 1, -1));
  }

  const params = new URLSearchParams(location.search);
  const interest = form?.querySelector<HTMLInputElement>("[data-interest]");
  if (interest) interest.value = params.get("paket") ?? "";

  const withParams = (href: string, add: Record<string, string>) => {
    try {
      const url = new URL(href);
      Object.entries(add).forEach(([k, v]) => v && url.searchParams.set(k, v));
      return url.toString();
    } catch {
      return href;
    }
  };

  const showError = (msg: string) => {
    if (!errorEl) return;
    errorEl.textContent = msg;
    errorEl.hidden = false;
  };

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form || !result || !submit) return;
    if (errorEl) errorEl.hidden = true;

    const data = new FormData(form);
    if (data.get("_gotcha")) return;

    const pages = String(data.get("seiten") ?? "");
    const features = data.getAll("funktionen").map(String);
    const name = String(data.get("name") ?? "").trim();
    const email = String(data.get("email") ?? "").trim();

    if (!pages) {
      show(1, -1);
      return;
    }

    if (!name || !/^\S+@\S+\.\S+$/.test(email) || !data.get("einwilligung")) {
      showError("Bitte füllen Sie Name und E-Mail aus und setzen Sie den Haken bei der Einwilligung.");
      return;
    }

    const outcome = recommend(pages, features);
    data.set("empfehlung", outcome);
    data.set("funktionen", features.join(", ") || "keine");

    submit.disabled = true;
    if (submitText) submitText.textContent = submit.dataset.sending ?? "Wird gesendet …";

    try {
      const res = await fetch(form.action, {
        method: "POST",
        body: data,
        headers: { Accept: "application/json" },
      });
      if (!res.ok) throw new Error(String(res.status));
    } catch {
      submit.disabled = false;
      if (submitText) submitText.textContent = submitLabel;
      showError(form.dataset.errorText ?? "");
      return;
    }

    result.querySelectorAll<HTMLElement>("[data-outcome]").forEach((card) => {
      card.hidden = card.dataset.outcome !== outcome;
    });
    result.querySelectorAll<HTMLElement>("[data-shop-note]").forEach((n) => {
      n.hidden = !features.includes("shop");
    });
    result.querySelectorAll<HTMLAnchorElement>("[data-stripe]").forEach((a) => {
      a.href = withParams(a.href, { prefilled_email: email });
    });
    result.querySelectorAll<HTMLAnchorElement>("[data-cal]").forEach((a) => {
      a.href = withParams(a.href, { name, email });
    });

    if (wiz) wiz.hidden = true;
    result.hidden = false;
    result.focus();
    result.scrollIntoView({ behavior: reduced ? "auto" : "smooth", block: "start" });
  });
</script>

<style>
  .wiz {
    position: relative;
    padding: clamp(1.5rem, 1rem + 3vw, 3rem);
    border-radius: calc(var(--ux-radius-lg) + 0.5rem);
    background: var(--ux-bg);
    border: 1px solid var(--ux-border);
    box-shadow: var(--ux-shadow-md);
  }

  .wiz__progress {
    display: none;
    align-items: center;
    gap: var(--ux-space-4);
    margin-bottom: var(--ux-space-6);
  }

  .wiz.is-wizard .wiz__progress {
    display: flex;
  }

  .wiz__bar {
    flex: 1;
    height: 6px;
    border-radius: var(--ux-radius-pill);
    background: var(--ux-surface-2);
    overflow: hidden;
  }

  .wiz__bar i {
    display: block;
    width: 20%;
    height: 100%;
    border-radius: inherit;
    background: var(--ux-gradient);
    transition: width 0.6s var(--ux-ease-out);
  }

  .wiz__count {
    flex: none;
    font-size: var(--ux-text-sm);
    font-weight: 700;
    color: var(--ux-muted);
  }

  .check {
    display: grid;
    gap: var(--ux-space-7);
  }

  .check__hp {
    position: absolute;
    left: -9999px;
  }

  .step {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .wiz.is-wizard .step:not(.is-active) {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .wiz.is-wizard .step.is-active {
      animation: step-in 0.55s var(--ux-ease-out) both;
    }

    .wiz.is-wizard .step.is-active.is-back {
      animation-name: step-back;
    }
  }

  @keyframes step-in {
    from { opacity: 0; translate: 28px 0; }
  }

  @keyframes step-back {
    from { opacity: 0; translate: -28px 0; }
  }

  .step__q {
    float: left;
    width: 100%;
    padding: 0;
    margin-bottom: var(--ux-space-5);
    font-family: var(--ux-font-display);
    font-size: var(--ux-text-2xl);
    line-height: var(--ux-leading-tight);
    color: var(--ux-navy-deep);
  }

  .step__q + * {
    clear: both;
  }

  .step__hint {
    margin: calc(-1 * var(--ux-space-2)) 0 var(--ux-space-5);
    color: var(--ux-muted);
  }

  .step__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ux-space-4) var(--ux-space-5);
    margin-top: var(--ux-space-6);
  }

  .wiz:not(.is-wizard) :global([data-next]),
  .wiz:not(.is-wizard) .step__link {
    display: none;
  }

  .step__link {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-weight: 700;
    color: var(--ux-navy);
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }

  .step__link:hover {
    color: var(--ux-teal-ink);
  }

  .options {
    display: grid;
    gap: var(--ux-space-3);
  }

  .options--grid {
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
  }

  .option {
    position: relative;
    cursor: pointer;
  }

  .option input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .option span {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ux-space-3);
    padding: 1rem 1.25rem;
    border: 1.5px solid var(--ux-border);
    border-radius: var(--ux-radius-md);
    background: var(--ux-bg);
    font-weight: 700;
    color: var(--ux-ink);
    transition:
      border-color var(--ux-dur-hover) var(--ux-ease-out),
      background-color var(--ux-dur-hover) var(--ux-ease-out),
      transform var(--ux-dur-hover) var(--ux-ease-out),
      box-shadow var(--ux-dur-hover) var(--ux-ease-out);
  }

  .option span :global(.icon) {
    color: var(--ux-teal-ink);
    opacity: 0;
    translate: -6px 0;
    transition:
      opacity var(--ux-dur-hover) var(--ux-ease-out),
      translate var(--ux-dur-hover) var(--ux-ease-out);
  }

  .option:hover span {
    border-color: var(--ux-teal);
    transform: translateY(var(--ux-lift));
    box-shadow: var(--ux-shadow-sm);
  }

  .option:hover span :global(.icon),
  .option input:checked + span :global(.icon) {
    opacity: 1;
    translate: 0 0;
  }

  .option input:checked + span {
    border-color: var(--ux-teal);
    background: rgb(0 195 160 / 0.08);
    color: var(--ux-navy-deep);
  }

  .option input:focus-visible + span {
    outline: 2px solid var(--ux-teal);
    outline-offset: 2px;
  }

  .option--check span {
    justify-content: flex-start;
  }

  .option__box {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.35rem;
    height: 1.35rem;
    border: 1.5px solid var(--ux-border);
    border-radius: 6px;
    transition:
      background-color var(--ux-dur-hover) var(--ux-ease-out),
      border-color var(--ux-dur-hover) var(--ux-ease-out);
  }

  .option--check span .option__box :global(.icon) {
    color: var(--ux-on-dark);
    opacity: 0;
    translate: none;
  }

  .option--check input:checked + span .option__box {
    background: var(--ux-teal-ink);
    border-color: var(--ux-teal-ink);
  }

  .option--check input:checked + span .option__box :global(.icon) {
    opacity: 1;
  }

  .fields {
    display: grid;
    gap: var(--ux-space-4);
  }

  @media (min-width: 40rem) {
    .fields {
      grid-template-columns: 1fr 1fr;
    }

    .fields__full {
      grid-column: 1 / -1;
    }
  }

  .field-label {
    display: grid;
    gap: var(--ux-space-2);
    font-size: var(--ux-text-sm);
    font-weight: 700;
  }

  .field {
    width: 100%;
    padding: 0.85rem 1rem;
    border: 1.5px solid var(--ux-border);
    border-radius: var(--ux-radius-md);
    background: var(--ux-bg);
    font: inherit;
    font-weight: 400;
    color: var(--ux-ink);
    transition:
      border-color var(--ux-dur-hover) var(--ux-ease-out),
      box-shadow var(--ux-dur-hover) var(--ux-ease-out);
  }

  .field--lg {
    padding: 1.05rem 1.25rem;
    font-size: var(--ux-text-lg);
  }

  .field:focus {
    outline: none;
    border-color: var(--ux-teal);
    box-shadow: 0 0 0 4px rgb(0 195 160 / 0.18);
  }

  .more {
    margin-top: var(--ux-space-4);
  }

  .more summary {
    width: fit-content;
    font-size: var(--ux-text-sm);
    font-weight: 700;
    color: var(--ux-navy);
    cursor: pointer;
  }

  .more[open] summary {
    margin-bottom: var(--ux-space-4);
  }

  .consent {
    display: flex;
    gap: var(--ux-space-3);
    align-items: flex-start;
    margin-top: var(--ux-space-5);
    font-size: var(--ux-text-sm);
    color: var(--ux-muted);
  }

  .consent input {
    margin-top: 0.3em;
    accent-color: var(--ux-navy);
    width: 1.1rem;
    height: 1.1rem;
  }

  .check__error {
    margin-top: var(--ux-space-5);
    padding: var(--ux-space-4);
    border-radius: var(--ux-radius-md);
    background: #fdecec;
    color: #8a1c1c;
    font-weight: 700;
  }

  .wiz__back {
    display: none;
    align-items: center;
    gap: var(--ux-space-2);
    justify-self: start;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: var(--ux-text-sm);
    font-weight: 700;
    color: var(--ux-muted);
    cursor: pointer;
  }

  .wiz.is-wizard .wiz__back:not([hidden]) {
    display: inline-flex;
  }

  .wiz__back:hover {
    color: var(--ux-navy);
  }

  .wiz__back :global(.wiz__back-icon) {
    rotate: 180deg;
  }

  .result:focus {
    outline: none;
  }

  .result__card {
    padding: clamp(2rem, 1.5rem + 3vw, 3.5rem);
    border-radius: var(--ux-radius-lg);
    background:
      radial-gradient(30rem 18rem at 100% 0%, rgb(0 195 160 / 0.3), transparent 65%),
      var(--ux-navy-deep);
    color: var(--ux-on-dark);
    box-shadow: var(--ux-shadow-lg);
    animation: ux-reveal 0.8s var(--ux-ease-out) both;
  }

  .result__sent {
    display: inline-flex;
    gap: var(--ux-space-2);
    align-items: center;
    margin-bottom: var(--ux-space-6);
    padding: 6px 14px;
    border-radius: var(--ux-radius-pill);
    background: rgb(0 195 160 / 0.15);
    color: var(--ux-teal);
    font-size: var(--ux-text-sm);
    font-weight: 700;
  }

  .result__card h2 {
    color: var(--ux-on-dark);
  }

  .result__price {
    margin-top: var(--ux-space-4);
    font-family: var(--ux-font-display);
    font-size: var(--ux-text-3xl);
    line-height: 1;
  }

  .result__price span,
  .result__price small {
    font-family: var(--ux-font-body);
    font-size: var(--ux-text-base);
    color: var(--ux-on-dark-muted);
  }

  .result__price span {
    margin-right: 0.35rem;
  }

  .result__price small {
    margin-left: 0.35rem;
  }

  .result__text {
